{

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "culinary-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "DB", "database_name": "culinary-server" }],
  "r2_buckets": [{ "binding": "PACKAGES", "bucket_name": "culinary-server-packages" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "triggers": { "crons": ["17 4 * * *"] },
  
  "vars": {

    "ADMIN_ORIGINS": "http://tauri.localhost",
    // Public half of the offline root (secrets/root-public.pem); verifies intermediates and the key floor.
    "ROOT_PUBLIC_SPKI": "MCowBQYDK2VwAyEA-cb9-PZR6r_NBC4CmewxQMRdkx__Y3gOlULuW3gqizI"

  }

}